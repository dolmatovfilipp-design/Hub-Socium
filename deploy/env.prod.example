# Copy to deploy/.env.prod (do not commit). All values are placeholders.
HUB_DOMAIN=hub.example.com
HUB_ENV=production

POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hub

# Must be ≥ 32 characters in production (API fail-fast).
JWT_SECRET=replace-with-at-least-32-char-random-secret

# Point at compose postgres service (or managed PG).
DATABASE_URL=postgres://hub:change-me-strong-password@postgres:5432/hub?sslmode=disable

CORS_ORIGINS=https://hub.example.com,https://www.hub.example.com

# Email for password reset (docs/EMAIL.md). Uncomment and fill in a real SMTP account.
# Without SMTP_HOST the reset endpoint answers 503 (and the API logs a warning at start).
# Check after deploy:  docker compose ... exec api /app/api -send-test-email you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_TLS=tls
# SMTP_USERNAME=no-reply@hub.example.com
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=Get Hub <no-reply@hub.example.com>
