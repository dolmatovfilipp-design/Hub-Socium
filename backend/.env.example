# Leave DATABASE_URL empty (or set HUB_EMBEDDED_PG=1) to use embedded Postgres under .data/pg
# DATABASE_URL=postgres://hub:hub@localhost:5432/hub?sslmode=disable
HUB_EMBEDDED_PG=1
# Dev/embedded: short or default JWT_SECRET OK. Outside embedded/dev: JWT_SECRET required and ≥ 32 chars (fail-fast).
# HUB_ENV=dev
# APP_ENV=development
JWT_SECRET=hub-dev-jwt-secret-change-me-32chars
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Or for tunnel/dev: CORS_ORIGINS=*
# Optional Sentry (no-op when unset; see docs/SENTRY.md)
# SENTRY_DSN=
# SENTRY_ENV=staging
# SENTRY_RELEASE=

# Private beta: invite-only registration (default on; set 0 to disable)
HUB_REQUIRE_INVITE=1
# Moderator token for GET /v1/mod/reports (X-Hub-Mod-Token or Bearer)
# HUB_MOD_TOKEN=


# Optional S3-compatible storage (Yandex / Selectel / R2). Empty = local .data/media
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=hub-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# Voice commands on iPhone (POST /v1/voice/transcribe).
# Default provider is Yandex SpeechKit (audio stays in Russia). Clip is stored
# in the same bucket under voice-stt/ and deleted after 24 hours.
# Without these keys the API still starts. GET /v1/voice/status returns ready:false
# and a hint naming the missing variable. Chrome can recognize speech in the browser.
# YANDEX_SPEECHKIT_API_KEY=
# YANDEX_SPEECHKIT_FOLDER=
# Falls back to YANDEX_GPT_FOLDER when the folder above is empty.
# Cross-border opt-in only:
# VOICE_STT_PROVIDER=openai
# OPENAI_API_KEY=

# LLM: compose assist, chat catch-up, reply chips, seller drafts, stickers.
# Stickers use OpenAI images when OPENAI_API_KEY is set, otherwise a sticker
# drawn from the text model. Without either key the UI says AI is not connected.
# Catch-up translation uses TRANSLATE_URL when set, otherwise the same LLM.
# It does not use the keyless fallback.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER=

# Voice transcripts: self-hosted Whisper (deploy compose service "stt").
# Unset and no SpeechKit key → http://stt:8000. STT_URL= (empty) turns it off.
# STT_URL=http://127.0.0.1:8000
# STT_LANGUAGE=ru
# STT_MODEL=Systran/faster-whisper-small
# MEDIA_DIR=.data/media

# Message translation. LibreTranslate if TRANSLATE_URL is set; else OpenAI / Yandex;
# else keyless MyMemory unless TRANSLATE_FALLBACK=0.
# TRANSLATE_URL=
# TRANSLATE_API_KEY=
# TRANSLATE_FALLBACK=1

# Coturn (use-auth-secret). Username is "<expiry>:hub", credential is base64(HMAC-SHA1).
# HUB_TURN=
# HUB_TURN_URLS=turn:31.31.192.151:3478,turns:31.31.192.151:5349

# YooKassa: channel subscriptions, paid posts, and in-chat orders.
# Without these keys those pay buttons say payment is not connected.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Optional image moderation hook
# YANDEX_VISION_API_KEY=
