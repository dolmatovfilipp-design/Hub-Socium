# Leave DATABASE_URL empty (or set HUB_EMBEDDED_PG=1) to use embedded Postgres under .data/pg
# DATABASE_URL=postgres://hub:hub@localhost:5432/hub?sslmode=disable
HUB_EMBEDDED_PG=1
# Dev/embedded: short or default JWT_SECRET OK. Outside embedded/dev: JWT_SECRET required and ≥ 32 chars (fail-fast).
# HUB_ENV=dev
# APP_ENV=development
JWT_SECRET=hub-dev-jwt-secret-change-me-32chars
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Or for tunnel/dev: CORS_ORIGINS=*
# Optional Sentry (no-op when unset; see docs/SENTRY.md)
# SENTRY_DSN=
# SENTRY_ENV=staging
# SENTRY_RELEASE=

# Private beta: require invite_code on register (1/true)
# HUB_REQUIRE_INVITE=1
# Moderator token for GET /v1/mod/reports (X-Hub-Mod-Token or Bearer)
# HUB_MOD_TOKEN=


# Optional S3-compatible storage (Yandex / Selectel / R2). Empty = local .data/media
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=hub-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# LLM compose assist (never used for feed ranking)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER=

# YooKassa sandbox (demo checkout only)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# Optional image moderation hook
# YANDEX_VISION_API_KEY=
