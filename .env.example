VITE_USE_API=true
VITE_API_URL=

# Web Push (VAPID) — generate: ./scripts/vapid-keygen.sh  or  npx web-push generate-vapid-keys
# Public key goes to BOTH FE (Vite) and API. Private key — API only, never commit.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# Password reset: without SMTP_HOST the API returns dev_code in JSON (honest local/dev).
# Set SMTP_HOST (or HUB_HIDE_RESET_CODE=1) to hide codes from responses.
# SMTP_HOST=
# HUB_HIDE_RESET_CODE=

# Sentry (optional — omit to disable; see docs/SENTRY.md)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=staging
# VITE_SENTRY_RELEASE=
