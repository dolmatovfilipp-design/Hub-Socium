VITE_USE_API=true
VITE_API_URL=

# Web Push (VAPID). If the two keys below are empty, the API generates a pair
# and writes it into this file (or VAPID_ENV_FILE). Private key stays on the server.
# The browser reads the public key from GET /v1/push/vapid.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:help@gethub.online

# Password reset: without SMTP_HOST the API returns dev_code in JSON (honest local/dev).
# Set SMTP_HOST (or HUB_HIDE_RESET_CODE=1) to hide codes from responses.
# SMTP_HOST=
# HUB_HIDE_RESET_CODE=

# Sentry (optional — omit to disable; see docs/SENTRY.md)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENV=staging
# VITE_SENTRY_RELEASE=


# Optional analytics / maps (FE)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://app.posthog.com
# VITE_PLAUSIBLE_DOMAIN=
# VITE_YANDEX_MAPS_KEY=

# FCM/APNs — native push later; Web Push uses VAPID above.

# Backend integrations (also see backend/.env.example) — copy to backend/.env
# Selectel media: S3_ENDPOINT, S3_REGION, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY, optional S3_PUBLIC_BASE
# OPENAI_*, YANDEX_GPT_*, YOOKASSA_*, YANDEX_VISION_API_KEY, SENTRY_DSN
